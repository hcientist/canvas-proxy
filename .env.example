# Copy to .env and fill in. Never commit the real file.
# docker compose reads this same file, both for the container's environment
# and for ${...} substitution in docker-compose.yml.

# --- Django ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-50-random-characters
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=canvas-proxy.example.edu

# Public origin of this proxy. Every Canvas developer key must list
# ${PROXY_BASE_URL}/oauth2/canvas/callback as a redirect URI.
PROXY_BASE_URL=https://canvas-proxy.example.edu
CSRF_TRUSTED_ORIGINS=https://canvas-proxy.example.edu

# --- Canvas ---
CANVAS_BASE_URL=https://school.instructure.com

# Encrypts Canvas tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating this makes every stored Canvas token unreadable; users reauthorize.
TOKEN_ENCRYPTION_KEY=

# --- The three developer keys ---
# Create three API developer keys in Canvas (Admin > Developer Keys), each with
# the redirect URI above, and paste their IDs and secrets here. Scope each key
# in Canvas to match the tier it backs.
CANVAS_KEY_READ_BASIC_ID=
CANVAS_KEY_READ_BASIC_SECRET=
CANVAS_KEY_READ_WRITE_ID=
CANVAS_KEY_READ_WRITE_SECRET=
CANVAS_KEY_FULL_ID=
CANVAS_KEY_FULL_SECRET=

# Which tier's key signs developers in to this dashboard.
CANVAS_LOGIN_TIER=read_basic

# --- Docker compose ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# --- Behind a reverse proxy ---
# Nginx Proxy Manager terminates TLS and forwards plain HTTP with
# X-Forwarded-Proto: https, which BEHIND_TLS_PROXY teaches Django to trust.
BEHIND_TLS_PROXY=1
# Leave both of these unset in normal use -- they default on. Set them to 0
# *together* only while testing over plain http, before the proxy has a
# certificate. SECURE_SSL_REDIRECT on with no TLS in front bounces the browser
# between http and https forever; SECURE_COOKIES on with no TLS means the CSRF
# cookie is never sent back and every form POST fails with a bare 403.
# SECURE_SSL_REDIRECT=0
# SECURE_COOKIES=0

# --- Outside Docker: database and cache ---
# Compose sets both of these for you; uncomment only for a bare-metal install.
# DATABASE_URL=postgres://user:password@localhost:5432/canvasproxy
# CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
# CACHE_LOCATION=redis://127.0.0.1:6379/1

# --- Tuning ---
ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL=7776000
RATE_LIMIT_PER_MINUTE=600
REQUEST_LOG_RETENTION_DAYS=90
CANVAS_TIMEOUT=30
